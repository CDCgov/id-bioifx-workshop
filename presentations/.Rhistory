WHERE
ALN.protein = "HA"
AND IF(
ALN.isl_ha_type = "Hvic",
ALN.reference_id = "BRISBANE60",
ALN.reference_id != "BRISBANE60"
)
),
NA_VARIANTS AS (
SELECT
iNA.*
FROM (
SELECT
ALN.isolate_id,
CAST(
(
LENGTH(ALN.aa_seq) - LENGTH(REPLACE(ALN.aa_seq, "X", ""))
) AS INT
) AS na_variants
FROM
dais.alignments AS ALN
INNER JOIN
dais.isolate_rep AS IREP ON ALN.cdc_id = IREP.cdc_id
AND ALN.isolate_id = IREP.isolate_id
AND ALN.variant_hash = IREP.variant_hash
AND ALN.flu_sequence_id = IREP.flu_sequence_id
AND ALN.`version` = IREP.rep_version
AND ALN.protein = IREP.protein
WHERE
ALN.protein = "NA"
) AS iNA
WHERE
NOT iNA.na_variants IS NULL
AND iNA.na_variants >= 1
),
MINOR_VARIANT_DETECTION AS (
SELECT
VAR.*,
RIGHT(SUBSTRING(ALNP.aa_aln, 1, VAR.position_aa), 1) AS residue_ref
FROM
dais.variants AS VAR
INNER JOIN dais.aligned_proteins AS ALNP ON VAR.variant_hash = ALNP.variant_hash
AND VAR.reference_id = ALNP.reference_id
WHERE
VAR.protein IN (
"HA",
"NA"
)
AND VAR.allele_type = "Minority"
AND (
VAR.frequency >= 0.05
AND VAR.frequency <= 0.20
)
AND IF(
(
VAR.flu_type = "B"
AND VAR.protein = "HA"
),
VAR.reference_id = "BRISBANE60",
TRUE
)
),
EXTRACT_HA_MINOR_VARIANTS AS (
SELECT
MVD.isolate_id,
MVD.version,
MVD.flu_sequence_id,
MVD.protein,
COUNT(
DISTINCT
MVD.position_disc,
MVD.allele,
MVD.residue
) AS ha_minor_variants
FROM
MINOR_VARIANT_DETECTION AS MVD
WHERE
MVD.residue IS DISTINCT FROM MVD.residue_ref
AND MVD.protein = "HA"
GROUP BY
MVD.isolate_id,
MVD.version,
MVD.flu_sequence_id,
MVD.protein
),
EXTRACT_NA_MINOR_VARIANTS AS (
SELECT
MVD.isolate_id,
MVD.version,
MVD.flu_sequence_id,
MVD.protein,
COUNT(
DISTINCT
MVD.position_disc,
MVD.allele,
MVD.residue
) AS na_minor_variants
FROM
MINOR_VARIANT_DETECTION AS MVD
WHERE
MVD.residue IS DISTINCT FROM MVD.residue_ref
AND MVD.protein = "NA"
GROUP BY
MVD.isolate_id,
MVD.version,
MVD.flu_sequence_id,
MVD.protein
),
LINKED_HA_MINOR_VARIANTS AS (
SELECT
SEQ.isolate_id,
SEQ.date_uploaded,
HMV.ha_minor_variants
FROM
disc_denorm.sequence AS SEQ
INNER JOIN
dais.isolate_rep AS IREP ON SEQ.isolate_id = IREP.isolate_id
AND SEQ.sequence_id = IREP.flu_sequence_id
AND SEQ.segment = IREP.protein
AND SEQ.version = IREP.rep_version
LEFT JOIN
EXTRACT_HA_MINOR_VARIANTS AS HMV ON IREP.isolate_id = HMV.isolate_id
AND IREP.flu_sequence_id = HMV.flu_sequence_id
AND IREP.protein = HMV.protein
AND IREP.rep_version = HMV.version
WHERE
SEQ.segment = "HA"
),
LINKED_NA_MINOR_VARIANTS AS (
SELECT
SEQ.isolate_id,
SEQ.date_uploaded,
NMV.na_minor_variants
FROM
disc_denorm.sequence AS SEQ
INNER JOIN
dais.isolate_rep AS IREP ON SEQ.isolate_id = IREP.isolate_id
AND SEQ.sequence_id = IREP.flu_sequence_id
AND SEQ.segment = IREP.protein
AND SEQ.version = IREP.rep_version
LEFT JOIN
EXTRACT_NA_MINOR_VARIANTS AS NMV ON IREP.isolate_id = NMV.isolate_id
AND IREP.flu_sequence_id = NMV.flu_sequence_id
AND IREP.protein = NMV.protein
AND IREP.rep_version = NMV.version
WHERE
SEQ.segment = "NA"
),
FILTERED_RESPONSES AS (
SELECT
TEST.test_subtype AS subtype,
TEST.test_protocol,
TEST.test_id,
TEST.test_date,
TEST.sr_variant_hash,
TEST.sr_lot AS lot,
TEST.ag_cdc_id,
TEST.ag_isolate_id,
TEST.ag_variant_hash,
TEST.ag_type,
AVG(TEST.titer_log) AS titer_log
FROM
dais.antigenic_tests AS TEST
INNER JOIN
disc_denorm.specimen AS SPCM ON TEST.ag_cdc_id = SPCM.cdc_id
INNER JOIN
disc_denorm.isolate AS ISL ON TEST.ag_isolate_id = ISL.isolate_id
LEFT JOIN
HA_VARIANTS AS HV ON TEST.ag_sequenced_isolate_id = HV.isolate_id
AND TEST.ag_variant_hash = HV.variant_hash
LEFT JOIN
NA_VARIANTS AS NV ON TEST.ag_sequenced_isolate_id = NV.isolate_id
LEFT JOIN
LINKED_HA_MINOR_VARIANTS AS LHMV ON TEST.ag_sequenced_isolate_id = LHMV.isolate_id
AND TEST.ag_sequence_date_uploaded = LHMV.date_uploaded
LEFT JOIN
LINKED_NA_MINOR_VARIANTS AS LNMV ON TEST.ag_sequenced_isolate_id = LNMV.isolate_id
WHERE
SPCM.reason_for_submission = "surveillance"
AND IF(
TEST.ag_type = "test",
COALESCE(
SPCM.collection_date,
SPCM.estimated_collection_date
) >= DATE_SUB(NOW(),274),
TRUE
)
AND TEST.test_subtype IN (
"H1 swl",
"H3",
"B vic",
"B yam"
)
AND (
(
TEST.test_protocol != "hint_protocol"
AND (
TEST.test_protocol = "fra_protocol"
OR TEST.ag_back_titer >= 4
)
)
OR TEST.test_hint_calculation_method = "AFLUT"
)
AND TEST.test_date <= DATE_SUB(NOW(),7)
AND regexp_like(TEST.ag_entry_error, "^\\s*$")
AND TEST.titer_log IS NOT NULL
AND NOT TEST.titer_error
AND TEST.titer_reportable
AND TEST.ag_type IN (
"test",
"reference"
)
AND NOT TEST.ag_passage LIKE "%E%"
AND NOT TEST.ag_passage LIKE "%Spf%"
AND TEST.ag_variant_hash IS NOT NULL
AND TEST.ag_sequenced_isolate_id NOT IN (
SELECT
IPVT.isolate_id
FROM
ref_sys.isolate_pair_variants AS IPVT
WHERE
(
NOT IPVT.passage LIKE "%E%"
AND NOT IPVT.passage LIKE "%Spf%"
AND NOT IPVT.ref_passage LIKE "%E%"
AND NOT IPVT.ref_passage LIKE "%Spf%"
)
)
AND (
LHMV.ha_minor_variants IS NULL
OR LHMV.ha_minor_variants = 0
)
AND (
LNMV.na_minor_variants IS NULL
OR LNMV.na_minor_variants = 0
)
AND (
HV.ha_variants IS NULL
OR HV.ha_variants = 0
)
AND (
NV.na_variants IS NULL
OR NV.na_variants = 0
)
GROUP BY
TEST.test_subtype,
TEST.test_protocol,
TEST.test_id,
TEST.test_date,
TEST.sr_variant_hash,
TEST.sr_lot,
TEST.ag_variant_hash,
TEST.ag_cdc_id,
TEST.ag_isolate_id,
TEST.ag_type
),
-- Detect date a particular antiserum lot was last applied in antigenic surveillance
FILTER_APPLIED_ANTISERUM_PANEL AS (
SELECT
FR.subtype,
FR.test_protocol,
FR.sr_variant_hash,
FR.lot,
MAX( FR.test_date ) AS max_test_date
FROM
FILTERED_RESPONSES AS FR
GROUP BY
FR.subtype,
FR.test_protocol,
FR.sr_variant_hash,
FR.lot
),
EXTRACT_ANTISERUM_METADATA AS (
SELECT
FR.subtype,
FR.test_protocol,
FR.sr_variant_hash,
FR.lot,
IF(
(
HSR.animal_id = ""
OR HSR.animal_id IS NULL
OR FR.lot LIKE "%HUMAN%"
OR FR.lot LIKE "%uman%"
),
"non-ferret",
"ferret"
) AS inoculated_species,
SR.passage AS sr_passage,
IF(
(
SR.passage LIKE "%E%"
OR SR.passage LIKE "%Spf%"
),
TRUE,
FALSE
) AS egg_passage
FROM
FILTERED_RESPONSES AS FR
INNER JOIN
disc_denorm.concise_hiserum AS SR ON FR.lot = SR.sera_lot
AND FR.test_id = SR.hi_test_id
INNER JOIN
disc_denorm.hiserum AS HSR ON SR.hi_test_id = HSR.hi_test_id
AND SR.hi_serum_entry_id = HSR.hi_serum_entry_id
LEFT JOIN
FILTER_APPLIED_ANTISERUM_PANEL AS AP ON FR.subtype = AP.subtype
AND FR.test_protocol = AP.test_protocol
AND FR.sr_variant_hash = AP.sr_variant_hash
AND FR.lot = AP.lot
WHERE
AP.max_test_date >= DATE_SUB(NOW(),274)
GROUP BY
FR.subtype,
FR.test_protocol,
FR.sr_variant_hash,
FR.lot,
inoculated_species,
sr_passage,
egg_passage
),
AGGREGATE_RESPONSES AS (
SELECT
FR.subtype,
FR.test_protocol,
udx.sort_list_unique(GROUP_CONCAT(CAST(FR.test_id AS STRING), ", "), ", ") AS test_id_aggregate,
FR.sr_variant_hash,
FR.lot,
EAM.inoculated_species AS sr_inoculated_species,
EAM.egg_passage AS sr_egg_passage,
FR.ag_variant_hash,
FR.ag_cdc_id,
FR.ag_type,
AVG(FR.titer_log) AS titer_log,
CAST( ROUND((POWER(2, AVG(FR.titer_log)) * 5),0) AS INT ) AS titer_value
FROM
FILTERED_RESPONSES AS FR
INNER JOIN
EXTRACT_ANTISERUM_METADATA AS EAM ON FR.subtype = EAM.subtype
AND FR.test_protocol = EAM.test_protocol
AND FR.sr_variant_hash = EAM.sr_variant_hash
AND FR.lot = EAM.lot
GROUP BY
FR.subtype,
FR.test_protocol,
FR.sr_variant_hash,
FR.lot,
EAM.inoculated_species,
EAM.egg_passage,
FR.ag_variant_hash,
FR.ag_cdc_id,
FR.ag_type
),
PARSE_DATASETS AS (
SELECT
AR.*,
"cell_only" AS sr_aggregation
FROM
AGGREGATE_RESPONSES AS AR
WHERE
NOT AR.sr_egg_passage
UNION
SELECT
AR.*,
"egg_only" AS sr_aggregation
FROM
AGGREGATE_RESPONSES AS AR
WHERE
AR.sr_egg_passage
UNION
SELECT
AR.*,
"all" AS sr_aggregation
FROM
AGGREGATE_RESPONSES AS AR
)
SELECT
PD.subtype,
PD.test_protocol,
CONCAT(
PD.sr_variant_hash,
"::",
PD.lot
) AS sr_identifier,
CONCAT(
PD.ag_variant_hash,
"_",
PD.ag_cdc_id
) AS ag_identifier,
PD.titer_value,
PD.sr_aggregation
FROM
PARSE_DATASETS AS PD
')
View(all_tests)
all_tests_h3_hi <- all_tests %>%
filter(subtype == "H3" &
test_protocol == "hint_protocol" &
sr_aggregation == "cell_only")
all_tests_h3_hi_pivot <- pivot_wider(all_tests_h3_hi, names_from = sr_identifier, values_from = titer_value,
values_fill = NA,
values_fn = mean)
row.names(all_tests_h3_hi_pivot) <- all_tests_h3_hi_pivot$ag_identifier
all_tests_h3_hi_pivot_mat <- all_tests_h3_hi_pivot %>%
select(-subtype,-test_protocol,-ag_identifier,-sr_aggregation) %>%
as.data.frame()
row.names(all_tests_h3_hi_pivot_mat) <- all_tests_h3_hi_pivot$ag_identifier
all_tests_h3_hi_pivot_mat[] <- lapply(all_tests_h3_hi_pivot_mat, as.character)
all_tests_h3_hi_pivot_mat[] <- lapply(all_tests_h3_hi_pivot_mat, function(x){replace_na(x, "*")})
# Run with all cores
options(RacOptimizer.num_cores = parallel::detectCores())
# Create the acmap object, specifying the titer table
map <- acmap(
titer_table = all_tests_h3_hi_pivot_mat
)
# Perform some optimization runs on the map object to try and determine a best map
map <- optimizeMap(
map                     = map,
number_of_dimensions    = 3,
number_of_optimizations = 2000,
minimum_column_basis    = "none"
)
view(map)
View(all_tests_h3_hi_pivot_mat)
